{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dolphin-systems-caretaker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "dolphin-systems-leads",
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ],
  "vars": {
    "SITE_URL": "https://dolphinsystems.net/",
    "GITHUB_OWNER": "Dolphin-Systems",
    "GITHUB_REPO": "Dolphin-Systems",
    "GITHUB_BRANCH": "main",
    "AI_API_BASE": "https://api.deepseek.com",
    "BLOG_MODEL": "deepseek-chat",
    "CREATE_ISSUES_ON_FAILURE": "true"
  }
}
